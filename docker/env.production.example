# Load-bearing: sanctum stateful domains and URL generation derive from this
APP_URL=https://abode.example.com

DB_DATABASE=abode
DB_USERNAME=abode
DB_PASSWORD=

# Everything else is defaulted by the image. APP_KEY is generated on first boot
# and persisted in the abode-data volume; set it here only to override. DB_HOST
# and DB_PORT default to the compose db service (db:5432).
