APP_NAME=Abode
APP_ENV=production
# php artisan key:generate --show, once; keep it stable or sessions and encrypted data break
APP_KEY=
APP_DEBUG=false
# Load-bearing: sanctum stateful domains and URL generation derive from this
APP_URL=https://abode.example.com

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=abode
DB_USERNAME=abode
DB_PASSWORD=

# Database sessions survive image pulls; file sessions live in the container
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
